{
    "outputDir": "/tmp/.playwright-cli",
    "browser": {
        "browserName": "chromium",
        "contextOptions": {
            "viewport": null
        },
        "initScript": [
            "/run/manyoyo-playwright/stealth.init.js"
        ],
        "launchOptions": {
            "channel": "chrome",
            "chromiumSandbox": false,
            "headless": false,
            "args": [
                "--lang=en-US",
                "--window-size=1920,1058",
                "--window-position=0,0",
                "--disable-blink-features=AutomationControlled",
                "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
                "--disable-webrtc"
            ]
        }
    }
}
