[
    {
        "rule": "email",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/(usr|var/lib/dpkg|var/cache/debconf|etc|root/\\.cache/ms-playwright|root/\\.claude/plugins|root/\\.codex/skills|root/\\.local|opt)/",
        "reason": "镜像各层里的第三方内容：Debian 包的维护者邮箱（dpkg/debconf/usr/share/doc）、npm 全局包（Claude Code/Codex/Playwright）、Chrome 等二进制里的作者邮箱。只放行层内文件树，镜像配置与历史（层之外的 JSON）不在放行范围"
    },
    {
        "rule": "local-path",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/(?!usr/local/lib/node_modules/manyoyo/)(usr|var/lib/dpkg|var/cache/debconf|etc|root/\\.cache/ms-playwright|root/\\.claude/plugins|root/\\.codex/skills|root/\\.local|opt)/",
        "reason": "第三方二进制（Chrome、codex、claude、Go/Rust 程序）内嵌的上游构建路径与示例路径（多为 GitHub runner 的 /home/runner、/Users/runner）；层之外的镜像配置与历史不放行"
    },
    {
        "rule": "private-key",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/(?:usr/local/lib/node_modules/(?:npm/(?:docs/content/using-npm/config\\.md|docs/output/using-npm/config\\.html|man/man7/config\\.7|node_modules/@npmcli/config/lib/definitions/definitions\\.js)|@anthropic-ai/claude-code/bin/claude\\.exe|@anthropic-ai/claude-code/node_modules/@anthropic-ai/claude-code-linux-(?:arm64|x64)/claude|@openai/codex/node_modules/@openai/codex-linux-(?:arm64|x64)/vendor/[^/]+/codex-resources/voice/lib/libgio-2\\.0\\.so\\.0)|usr/bin/(?:ssh|ssh-add|ssh-keygen)|usr/sbin/sshd|usr/lib/openssh/ssh-keysign|usr/lib/[a-z0-9_]+-linux-gnu/(?:libgnutls\\.so\\.[0-9.]+|libssh\\.so\\.[0-9.]+)|usr/lib/file/magic\\.mgc)$",
        "reason": "第三方二进制/文档里的 PEM 头字符串（npm 文档、claude/codex 二进制、ssh 工具、libgnutls、libssh、file 的 magic 库），不是真实私钥。按具体文件放行：其它位置（含 /etc、/opt、/root/.local、/usr/local 下自带代码）出现私钥都会被扫出来"
    },
    {
        "rule": "token",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/usr/local/lib/node_modules/@openai/codex/",
        "reason": "codex 官方二进制内的示例性 sk- 字符串（文档/测试数据），非真实凭据"
    },
    {
        "rule": "sensitive-filename",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/(etc/ssl/certs|usr/share/ca-certificates|usr/local/share/ca-certificates)/[^/]+\\.(pem|crt)$",
        "reason": "系统公共 CA 根证书（公开数据）"
    },
    {
        "rule": "sensitive-filename",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/root/\\.claude/plugins/marketplaces/[^/]+/\\.git$",
        "reason": "构建时 `claude plugin install` 克隆的官方插件市场仓库的 .git 目录（公开仓库，不含维护者信息）；若后续清理该目录可删除本条"
    },
    {
        "rule": "email",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/root/\\.(claude|gemini|codex)/skills/",
        "reason": "`playwright-cli install --skills` 安装的第三方技能文档，里面是示例邮箱（如 user@example.com）"
    },
    {
        "rule": "email",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/var/log/bootstrap\\.log$",
        "reason": "Ubuntu 基础镜像自带的 debootstrap 日志（含 Debian 包版权里的维护者邮箱），非本项目产生"
    },
    {
        "rule": "sensitive-filename",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/(usr/lib/ssl/cert\\.pem|usr/lib/python3/dist-packages/pip/_vendor/certifi/cacert\\.pem)$",
        "reason": "公共 CA 证书包（公开数据）"
    },
    {
        "rule": "sensitive-filename",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/(usr/local/lib/node_modules/npm/\\.npmrc|root/\\.claude/plugins/marketplaces/[^/]+/external_plugins/[^/]+/\\.npmrc)$",
        "reason": "第三方包自带的 .npmrc（npm 自身与官方插件仓库里的），内容仍受 token 规则扫描"
    },
    {
        "rule": "sensitive-filename",
        "pathPattern": "^[^!]*(?:![^!]*\\.tar|!/blobs/sha256/[0-9a-f]{64})?!/root/\\.npmrc$",
        "reason": "Dockerfile 的 `npm config set registry` / allow-scripts 生成（已核对内容只有 registry 与 allow-scripts，无凭据）；内容仍受 token 规则扫描，将来混入凭据会被抓到"
    }
]
