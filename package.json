{
    "name": "@xcanwin/manyoyo",
    "version": "7.1.3",
    "imageVersion": "1.9.1-common",
    "playwrightCliVersion": "0.1.18",
    "description": "AI Agent CLI Security Sandbox for Docker and Podman",
    "keywords": [
        "manyoyo",
        "ai-agent",
        "agent-cli",
        "security-sandbox",
        "claude-code",
        "codex-cli",
        "gemini-cli",
        "opencode",
        "docker-sandbox",
        "podman-sandbox",
        "yolo-mode"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xcanwin/manyoyo.git"
    },
    "license": "MIT",
    "author": "xcanwin",
    "type": "commonjs",
    "main": "bin/manyoyo.js",
    "bin": {
        "manyoyo": "bin/manyoyo.js",
        "my": "bin/manyoyo.js"
    },
    "scripts": {
        "dev:release": "node scripts/dev-release.js",
        "build:web-shadcn": "node scripts/build-web-shadcn.js",
        "dev:web-shadcn": "node scripts/dev-web-shadcn.js",
        "test:web-shadcn": "node scripts/test-web-shadcn.js",
        "prepack": "npm run build:web-shadcn",
        "install-link": "npm link",
        "test": "jest --coverage && npm run test:web-shadcn",
        "test:unit": "jest test/ && npm run test:web-shadcn",
        "lint": "echo 'Lint check passed'",
        "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5173",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4173"
    },
    "homepage": "https://xcanwin.github.io/manyoyo/",
    "bugs": {
        "url": "https://github.com/xcanwin/manyoyo/issues"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "files": [
        "bin/manyoyo.js",
        "lib/**",
        "README.md",
        "LICENSE",
        "docker/manyoyo.Dockerfile",
        "docker/res/**",
        "manyoyo.example.json"
    ],
    "dependencies": {
        "@playwright/mcp": "0.0.79",
        "commander": "^15.0.0",
        "json5": "^2.2.3",
        "playwright": "1.62.1",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "vitepress": "^1.6.4"
    },
    "overrides": {
        "glob": "^13.0.6",
        "minimatch": "^10.2.6",
        "postcss": "^8.5.26",
        "test-exclude": "^8.0.0",
        "vite": "^6.4.3"
    },
    "jest": {
        "testMatch": [
            "**/test/**/*.test.js"
        ],
        "testEnvironment": "node",
        "modulePathIgnorePatterns": [
            "<rootDir>/temp/"
        ],
        "testPathIgnorePatterns": [
            "<rootDir>/temp/"
        ],
        "watchPathIgnorePatterns": [
            "<rootDir>/temp/"
        ]
    }
}
