{
    // MANYOYO 全局配置文件，保存到 ~/.manyoyo/manyoyo.json

    // 容器基础参数（覆盖型：命令行 > runs.<name> > 全局配置 > 默认值）
    "containerName": "my-dev",
    "hostPath": "/path/to/your/project",
    "containerPath": "/path/to/your/project",
    "imageName": "ghcr.io/xcanwin/manyoyo",
    "imageVersion": "1.8.8-common",
    "containerMode": "common",
    // 容器运行时：auto（默认，自动选择）/ docker / podman，仅全局配置生效
    "containerRuntime": "auto",
    // serve 是否每天检查一次新版本（默认 true；请求只带固定的 User-Agent，不附带任何本机信息），仅全局配置生效
    "updateCheck": true,
    // 容器内 apt / npm / pip 软件源（http/https；留空或不写 = 各自的官方默认源），仅全局配置生效。
    // apt 只填镜像站主机（保留 /ubuntu 路径），例如 https://mirrors.aliyun.com；镜像本身不变，新建容器时生效
    "mirrors": {
        "apt": "",
        "npm": "",
        "pip": ""
    },

    // 容器启动环境（env 按 key 合并覆盖；其余数组参数会累加）
    // 仅支持绝对路径，如 /abs/path.env
    "envFile": [],
    "env": {
        "IS_SANDBOX": "1"
    },
    "volumes": [],
    "ports": ["8888:8888"],

    // 网络策略（新建容器时写入，Web「容器」页随时改，不需要重启容器）。不写 = 默认收紧：允许公网，
    // 禁止宿主机、局域网 / 私有网段、云元数据与其他容器。
    // preset：restricted（默认）/ allowlist（只放行你写的允许规则）/ custom（没匹配的就允许）
    // outbound / inbound：规则从上往下，第一条命中的生效。action：allow / deny；target（入站为 source）：
    // IP / 网段 / 域名（仅出站）/ @containers @container:<名称> @host @private @public @metadata @any；ports 空 = 全部；proto：all / tcp / udp
    "network": {
        "version": 2,
        "preset": "restricted",
        // 例：允许容器访问宿主机的 Ollama：{ "action": "allow", "target": "@host", "ports": "11434", "proto": "tcp" }
        "outbound": [],
        // 例：允许容器 B 访问我的 7000 端口：{ "action": "allow", "source": "@container:B", "ports": "7000", "proto": "tcp" }
        "inbound": [],
        // 端口暴露（需要 serve 运行）：监听地址默认 127.0.0.1；绑 0.0.0.0 等于局域网 / 公网可见
        "expose": []
    },

    // 容器每次启动（新建、重启、serve 拉起）都由容器内 init 执行一次的 bash 脚本；新建容器时写入，之后在 Web「容器」页随时改
    "autostart": "",
    // serve 启动时是否自动拉起此容器（配合 autostart 使用）
    "autostartOnServe": false,

    // 仅首次创建容器时执行一次（创建后、常规 shell 前）
    "first": {
        // 仅支持绝对路径，如 /abs/path.env
        "envFile": [],
        "env": {},
        "shellPrefix": "",
        "shell": "",
        "shellSuffix": ""
    },

    // 常规命令参数（覆盖型：命令行 > runs.<name> > 全局配置 > 默认值）
    "shellPrefix": "",
    "shell": "",
    "shellSuffix": "",
    "agentPromptCommand": "",
    "yolo": "",
    "quiet": ["tip", "cmd"],

    // 构建参数（数组累加）
    "imageBuildArgs": [],

    // 网页认证参数（覆盖型；支持环境变量兜底）
    // 优先级：命令行 > runs.<name> > 全局配置 > 环境变量 > 默认值
    "serverUser": "admin",
    "serverPass": "change-this-password",

    // serve 命令专属配置（覆盖型：runs.<name>.serve > 全局配置）
    // 不设置 serve 字段（或不设置 title 字段）时，网页 <title> 按当前会话 Agent 名动态显示
    // 一旦设置 title，则固定显示该值（不再随会话变化），留空字符串 "" 即固定显示为空
    // quickChat 是网页端"快捷对话"按钮的配置：path 为工作根目录（每次点击按时间戳建子目录），
    // run 为使用哪个 runs.<name> 配置；也可以在网页「系统设置 > 快捷对话」里填写，效果一样
    // "serve": {
    //     "title": "My MANYOYO",
    //     "quickChat": {
    //         "path": "~/.manyoyo/work/",
    //         "run": "claude"
    //     }
    // },

    // 可选插件（manyoyo playwright）：容器内浏览器默认就能用，这里只放少量可调项
    "plugins": {
        "playwright": {
            // headed / chrome / vnc 模式的浏览器服务端口（容器通过 token 路径连接）
            "port": 8935,
            // vnc 模式的原生 VNC 端口与 noVNC 网页端口（只发布到 127.0.0.1）
            "vncPort": 5900,
            "novncPort": 6080,
            // 浏览器语言与时区，留空时跟随宿主机
            "locale": "",
            "timezoneId": "",
            // 强制 navigator.platform；留空则使用浏览器真实值（推荐，与 UA、字体、WebGL 自洽）
            "navigatorPlatform": "",
            // 是否禁用 WebRTC（默认 true：否则 STUN 会暴露本机公网 IP；需要视频会议类网站时设为 false）
            "disableWebRTC": true,
            // chrome 模式读取的 DevToolsActivePort 文件；留空时自动探测常见路径
            "devtoolsActivePortPath": "",
            // playwright ext-download 的 CRX prodversion 参数
            "extensionProdversion": "132.0.0.0"
        }
    },

    // 运行配置集合：通过 -r <name> 读取 runs.<name>
    "runs": {
        "claude": {
            "containerName": "my-claude-{now}",
            "env": {
                "ANTHROPIC_MODEL": "claude-sonnet-4-5"
            },
            "first": {
                "shell": "echo first-init"
            },
            "shell": "claude",
            "agentPromptCommand": "claude -p {prompt}",
            "yolo": "c",
            "plugins": {
                "playwright": {
                    "locale": "zh-CN",
                    "timezoneId": "Asia/Shanghai"
                }
            }
        }
    }
}
